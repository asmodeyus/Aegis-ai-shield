{
  "manifest_version": 3,
  "name": "AEGIS-AI: Anti-Redirect, Video & Search Hijack Shield",
  "version": "3.2.1",
  "minimum_chrome_version": "111",
  "key": "",
  "description": "AEGIS-AI Shield v3.2.1: Anti-redirect, video-tap hijack & search-hijack shield with OAuth-safe filtering, isolated-world validation, wildcard Blacklist/DNR, reversible CAPTCHA guard, optional opt-in Gemini audit, and Native/Mini PiP.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "main_world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}

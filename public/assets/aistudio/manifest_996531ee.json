{
  "manifest_version": 3,
  "name": "AEGIS-AI: Anti-Redirect, Video & Search Hijack Shield",
  "version": "2.1.5",
  "key": "",
  "description": "Blokir in-tab redirect judol, Shopee/affiliate, shortlink ad-rotator (hai8g.com), & search hijack bebas CSP dengan Pengaturan lengkap.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "scripting",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "main_world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}